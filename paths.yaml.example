# Copy to paths.yaml (gitignored) and edit for your machine:
#   cp paths.yaml.example paths.yaml
# paths.yaml is the only file in the repo that holds absolute paths. Code builds
# every path as <root from this file> / <relative fragment from constants.py>.

# Root of this project's output node (00-references, 01-raw_data,
# 02-processed_data, 03-output).
project_output_root: /your/cluster/path/idd-human-suitability

# Input data and large intermediate files mostly live outside the output node.
# Each such location gets its own key below; no data location is written
# anywhere but in this file.

# Keys (from this file) of roots an automated coding session may write under,
# beyond the repo and the output node. Pipeline code ignores this entry.
write: []
